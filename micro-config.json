{
  "name": "YSS Metadata Platform MicroApp",
  "description": "数据中台元数据发现管理平台微应用 - 独立的 qiankun 微前端应用",
  "version": "1.0.0",
  "app": {
    "name": "数据中台元数据发现管理平台",
    "description": "元数据采集 / 发现 / 血缘 / 目录 / 治理 / 集成（切片 01：数据源管理与采集任务）",
    "path": "packages",
    "entry": "http://localhost:8084",
    "port": 8084,
    "type": "micro",
    "framework": "vue3",
    "activeRule": "/metadata-platform",
    "container": "#microapp-container",
    "features": ["数据源管理", "采集任务", "API 服务", "独立部署"]
  },
  "shared": {
    "dependencies": {
      "vue": "^3.4.0",
      "vue-router": "^4.2.5",
      "pinia": "^2.1.7",
      "ant-design-vue": "^4.0.0",
      "@ant-design/icons-vue": "^7.0.0"
    },
    "devDependencies": {
      "@vitejs/plugin-vue": "^4.5.2",
      "typescript": "~5.3.0",
      "vite": "^5.0.8",
      "vue-tsc": "^1.8.25"
    }
  },
  "development": {
    "proxy": {
      "/api": {
        "target": "http://localhost:8080",
        "changeOrigin": true
      }
    },
    "cors": true
  },
  "production": {
    "publicPath": "/",
    "outputDir": "dist",
    "assetsDir": "assets",
    "cdn": {
      "enabled": false,
      "externals": {
        "vue": "Vue",
        "vue-router": "VueRouter",
        "ant-design-vue": "antd"
      }
    }
  },
  "deployment": {
    "strategy": "independent",
    "registry": {
      "enabled": false,
      "url": "http://localhost:3001/registry"
    },
    "nginx": {
      "enabled": true,
      "config": "nginx.conf"
    }
  }
}
